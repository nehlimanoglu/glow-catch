---
import '../styles/showroom.css';

const { title, description, current } = Astro.props;
const year = new Date().getFullYear();

// One entry per game plus a single Legal door. With two games a bare
// "Privacy" link would quietly mean one of them; /legal names both.
const nav = [
  { href: '/',                label: 'Studio',         key: 'studio' },
  { href: '/glow-catch',      label: 'Glow Catch',     key: 'game'   },
  { href: '/pegboard-seven',  label: 'Pegboard Seven', key: 'game2'  },
  { href: '/legal',           label: 'Legal',          key: 'legal'  },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Archivo+Narrow:wght@600&display=swap">
</head>
<body>
<!--
THESIS: A one-person studio's site as a Memphis showroom floor — games are
objects on a shelf, not screenshots in a hero. Refuses the publisher-site
default of black ground, giant logotype and full-bleed game art.
OWN-WORLD: White paper, 3px black outlines on every object, four candy roles
(pink, mint, yellow, grape) as fills that own whole shapes; Bricolage Grotesque
at display weight against Archivo Narrow all-caps labels; terrazzo speckle only
where a section wants weight.
STORY: A visitor sees a studio with a point of view, understands the games it
has made, and can reach a person or a game's legal documents in one move.
FIRST VIEWPORT: Thin masthead rule; studio statement at display scale with one
yellow-highlighted phrase; the shelf of game objects anchored at the bottom with
the contact line opposite.
FORM: Memphis Milano showroom morning, candidate C of the presented directions;
seed key 8ca64122.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->

<div class="wrap">
  <header class="mast">
    <a class="wordmark" href="/"><span class="dot"></span>Nurçin Ehlimanoğlu</a>
    <nav>
      {nav.map(n => (
        <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <span>© {year} Nurçin Ehlimanoğlu</span>
    <span class="links">
      <a href="mailto:nehlimanoglu@gmail.com">nehlimanoglu@gmail.com</a>
      <a href="/legal">Legal</a>
      <a href="mailto:nehlimanoglu@gmail.com">Contact</a>
    </span>
  </footer>
</div>
</body>
</html>
